# ==============================================================================
# ContribPilot Configuration
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env
#
# ContribPilot will automatically read these variables, or you can use
# the CLI commands:
#   pnpm cli config --gemini <key>
#   pnpm cli config --github <token>
# ==============================================================================

# 1. Google Gemini API Key (BYOK)
# Get your free key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# 2. GitHub Personal Access Token
# Increases your GitHub API rate limit from 60 req/hr to 5,000 req/hr.
# Generate a token at: https://github.com/settings/tokens (Read-only / public repo access)
GITHUB_TOKEN=

# 3. Google OAuth 2.0 Credentials (Optional, for 'contribpilot login')
# Application type: Desktop app
# Create in Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 4. ContribPilot Hosted Gemini Key (Owner / Managed Quota for Paying Users)
# When users pay/upgrade to Pro, ContribPilot uses this hosted key to serve them.
CONTRIBPILOT_HOSTED_GEMINI_KEY=

# 5. Payment Page URL (Webpage opened when user upgrades to Pro)
# Opens in user's browser via 'contribpilot upgrade'
CONTRIBPILOT_PAYMENT_URL=https://contribpilot.dev/pricing
