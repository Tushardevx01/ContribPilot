# ContribPilot Environment Configuration
# Paste your keys below:

# 1. Google Gemini API Key (get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. GitHub Personal Access Token (get from https://github.com/settings/tokens)
GITHUB_TOKEN=your_github_token_here

# 3. Google OAuth 2.0 Credentials (Optional, for 'pnpm cli login')
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# 4. ContribPilot Hosted Gemini Key (Managed Quota for Pro / Paying Users)
CONTRIBPILOT_HOSTED_GEMINI_KEY=your_contribpilot_hosted_gemini_key_here

# 5. Payment Page URL (Webpage opened when user upgrades to Pro)
CONTRIBPILOT_PAYMENT_URL=https://contribpilot.dev/pricing

# 6. Groq API Key (Automatic failover when Gemini quota ends)
GROQ_API_KEY=your_groq_api_key_here

# 7. Dodo Payments API Key (Live Production Key)
DODO_PAYMENTS_API_KEY=your_dodo_payments_api_key_here
