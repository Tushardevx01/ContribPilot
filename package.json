{
  "name": "contribpilot-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "CLI tool that helps developers make mergeable open-source contributions",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "build": "turbo run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md,yaml,yml}\"",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "eslint": "^9.20.1",
    "prettier": "^3.5.1",
    "turbo": "^2.4.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
